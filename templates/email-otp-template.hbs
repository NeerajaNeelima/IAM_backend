<html>
  <head>
    <meta charset="UTF-8" />
    <title>GeniusCFO OTP Verification</title>
  </head>

  <body
    style="margin:0;padding:0;background-color:#f5f6f8;font-family:Arial,Helvetica,sans-serif;color:#232323;"
  >

    <!-- OUTER WRAPPER -->
    <table width="100%" cellpadding="0" cellspacing="0" bgcolor="#f5f6f8">
      <tr>
        <td align="center">

          <!-- EMAIL CONTAINER -->
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            bgcolor="#ffffff"
            style="border-radius:10px;overflow:hidden;"
          >

            <!-- LOGO -->
            <tr>
              <td align="center" style="padding:20px;">
                <img src="https://geniuscfo.app/company-logo.png" width="150" alt="GeniusCFO" />
              </td>
            </tr>

            <!-- HEADER -->
            <tr>
              <td style="padding:0 16px;">
                <table
                  width="100%"
                  height="250px"
                  cellpadding="0"
                  cellspacing="0"
                  style="border-radius:10px 10px 0 0; overflow:hidden;"
                >
                  <tr>
                    <td
                      style="
                    background:#892CDC url('https://geniuscfo.app/banner.png')
                    no-repeat center/cover;
                    padding:40px;
                    color:#ffffff;
                  "
                    >
                      <h1 style="margin:0;font-size:26px;font-weight:500;">IAM App</h1>
                      <p style="margin-top:8px;font-size:14px;">
                        Secure Account Creation and Login Features.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- CONTENT -->
            <tr>
              <td style="padding:30px 24px;">

                <h2 style="font-weight:500;margin-top:0;">Hi {{name}},</h2>

                <p style="font-size:14px;line-height:1.6;">
                  Here is your One Time Password (OTP).
                </p>

                <p style="font-size:14px;line-height:1.6;">
                  Please enter this code to verify your email address for
                  <strong>IAM App</strong>.
                </p>

                <!-- OTP TABLE -->
                <table align="center" cellpadding="0" cellspacing="0" style="margin:30px auto;">
                  <tr>
                    {{#each otp}}
                      <td style="padding:0 6px;">
                        <div
                          style="
                    width:48px;
                    height:48px;
                    background:#04ADF10D;
                    border-radius:6px;
                    text-align:center;
                    line-height:48px;
                    font-size:20px;
                    font-weight:600;
                    color:#10241B;"
                        >
                          {{this}}
                        </div>
                      </td>
                    {{/each}}
                  </tr>
                </table>

                <p style="font-size:14px;margin-top:30px;">
                  OTP will expire in
                  <strong>5 minutes</strong>.
                </p>

                <p style="margin-top:30px;font-size:14px;">
                  Best Regards,<br />
                  <p style="color:#04ADF1; font-weight:500">IAM App Team</p>
                </p>

              </td>
            </tr>

            <!-- SOCIAL -->
            <tr>
              <td
                align="center"
                style="border-top:2px solid #D9D9D9;border-bottom:2px solid #D9D9D9;padding:20px;"
              >
                <table cellpadding="0" cellspacing="0">
                  <tr>
                    <!-- Instagram -->
                    <td align="center" style="padding:0 6px;">
                      <table
                        role="presentation"
                        cellpadding="0"
                        cellspacing="0"
                        width="40"
                        height="40"
                        style="
        background-color:#04ADF1;
        border-radius:50%;
      "
                      >
                        <tr>
                          <td align="center" valign="middle">
                            <a href="https://www.instagram.com" target="_blank">
                              <img
                                src="https://geniuscfo.app/instagram.png"
                                width="10"
                                height="10"
                                alt="Instagram"
                                style="display:block;border:0;"
                              />
                            </a>
                          </td>
                        </tr>
                      </table>
                    </td>

                    <!-- Facebook -->
                    <td align="center" style="padding:0 6px;">
                      <table
                        role="presentation"
                        cellpadding="0"
                        cellspacing="0"
                        width="40"
                        height="40"
                        style="
        background-color:#04ADF1;
        border-radius:50%;
      "
                      >
                        <tr>
                          <td align="center" valign="middle">
                            <a href="https://www.facebook.com" target="_blank">
                              <img
                                src="https://geniuscfo.app/facebook.png"
                                width="10"
                                height="10"
                                alt="Facebook"
                                style="display:block;border:0;"
                              />
                            </a>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>

                </table>
              </td>
            </tr>

            <!-- FOOTER -->
            <tr>
              <td align="center" style="padding:20px;font-size:12px;color:#000000;">
                <p>© 2025 GeniusCFO. All rights reserved.</p>

                <p style="max-width:520px;margin:15px auto;">
                  You are receiving this mail because you registered to join the IAM platform
                  as a user or a creator. This also shows that you agree to our Terms of use and
                  Privacy Policies. If you no longer want to receive mails from us, click the
                  unsubscribe link below to unsubscribe.
                </p>

                <!-- FOOTER LINKS -->
                <table cellpadding="0" cellspacing="0" align="center">
                  <tr>
                    <!-- Privacy -->
                    <td style="padding:0 6px;">
                      <a
                        href="/"
                        style="color:#333333;text-decoration:underline;font-size:12px;"
                      >
                        Privacy Policy
                      </a>
                    </td>

                    <!-- Dot -->
                    <td align="center" valign="middle">
                      <table
                        role="presentation"
                        width="4"
                        height="4"
                        cellpadding="0"
                        cellspacing="0"
                      >
                        <tr>
                          <td
                            style="
            width:4px;
            height:4px;
            background-color:#D9D9D9;
            border-radius:50%;
          "
                          ></td>
                        </tr>
                      </table>
                    </td>

                    <!-- Terms -->
                    <td style="padding:0 6px;">
                      <a
                        href="/"
                        style="color:#333333;text-decoration:underline;font-size:12px;"
                      >
                        Terms of Service
                      </a>
                    </td>

                    <!-- Dot -->
                    <td align="center" valign="middle">
                      <table
                        role="presentation"
                        width="4"
                        height="4"
                        cellpadding="0"
                        cellspacing="0"
                      >
                        <tr>
                          <td
                            style="
            width:4px;
            height:4px;
            background-color:#D9D9D9;
            border-radius:50%;
          "
                          ></td>
                        </tr>
                      </table>
                    </td>

                    <!-- Help -->
                    <td style="padding:0 6px;">
                      <a
                        href="/"
                        style="color:#333333;text-decoration:underline;font-size:12px;"
                      >
                        Help Center
                      </a>
                    </td>

                    <!-- Dot -->
                    <td align="center" valign="middle">
                      <table
                        role="presentation"
                        width="4"
                        height="4"
                        cellpadding="0"
                        cellspacing="0"
                      >
                        <tr>
                          <td
                            style="
            width:4px;
            height:4px;
            background-color:#D9D9D9;
            border-radius:50%;
          "
                          ></td>
                        </tr>
                      </table>
                    </td>

                  </tr>

                </table>

              </td>
            </tr>

          </table>
          <!-- END CONTAINER -->

        </td>
      </tr>
    </table>

  </body>
</html>